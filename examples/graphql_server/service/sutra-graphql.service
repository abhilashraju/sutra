[Unit]
Description=Sutra GraphQL service (Redfish + D-Bus)
After=network.target xyz.openbmc_project.ObjectMapper.service bmcweb.service
Wants=xyz.openbmc_project.ObjectMapper.service

[Service]
Type=simple
# GraphQL over HTTPS on 127.0.0.1:18081 with bmcweb's certificate, Redfish
# source on https://127.0.0.1:443 (user "service") verified against the CA
# directory /etc/ssl/certs/authority. bmcweb's certificate is issued to
# CN=bmc.peer (no SAN), so --redfish-server-name makes the client verify that
# name while still connecting to 127.0.0.1. The client certificate and key are
# presented to the Redfish service for mutual TLS. D-Bus source on the system
# bus.
ExecStart=/usr/bin/graphql_server \
    --address 127.0.0.1 --port 18081 \
    --redfish https://127.0.0.1:443 \
    --redfish-user service \
    --schema /usr/share/sutra-graphql/schema.json \
    --cert /etc/ssl/certs/https/server_cert.pem \
    --key /etc/ssl/private/server_pkey.pem \
    --redfish-ca /etc/ssl/certs/authority \
    --redfish-server-name bmc.peer \
    --redfish-client-cert /etc/ssl/certs/https/client_cert.pem \
    --redfish-client-key /etc/ssl/private/client_pkey.pem \
    --bus system
# Holds the secret, never put it on the command line:
#   SUTRA_REDFISH_PASSWORD=...
# Create it with mode 0600, owned by root.
EnvironmentFile=/etc/default/sutra-graphql
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
